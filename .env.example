EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Kakao OAuth client values (safe to expose to the Expo client)
EXPO_PUBLIC_KAKAO_REST_API_KEY=your-kakao-rest-api-key
EXPO_PUBLIC_AUTH_API_URL=https://your-moveon-api.vercel.app

# Vercel server-only values (never prefix these with EXPO_PUBLIC_)
KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
FIREBASE_ADMIN_PROJECT_ID=moveon-25df9
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
AUTH_ALLOWED_ORIGINS=http://localhost:8081,https://your-moveon-web.vercel.app

# Move On Times AI generation (server-only, never prefix with EXPO_PUBLIC_)
OPENAI_API_KEY=
OPENAI_MODEL=
